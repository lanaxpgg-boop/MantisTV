+  for (const [id, field, label] of [['defaultIntro', 'defaultIntro', 'downloadIntro'], ['defaultBackdrop', 'defaultBackdrop', 'downloadBackdrop']]) {
+    const button = $(id);
+    if (!allowed && !s[field]) {
+      button.disabled = true;
+      button.dataset.capabilityDisabled = 'true';
+      button.textContent = t('assetUnavailable');
+    } else {
+      if (button.dataset.capabilityDisabled) {
+        delete button.dataset.capabilityDisabled;
+        button.disabled = false;
+      }
+      if (!button.disabled) button.textContent = s[field] ? t('assetRemove') : t(label);
+    }
+  }
